# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Port configuration (default 3000)
PORT=3000

# Email recipients for appointment bookings and feedback submissions
APPOINTMENT_RECIPIENT_EMAIL="orgio1298@gmail.com, contact@solongohospital.mn"
FEEDBACK_RECIPIENT_EMAIL="contact@solongohospital.mn, orgio1298@gmail.com"

# SMTP Configuration (Optional in local development; when configured, real emails are sent via Nodemailer)
# For production Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="example@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
SMTP_FROM="\"Солонго нүдний эмнэлэг\" <contact@solongohospital.mn>"
